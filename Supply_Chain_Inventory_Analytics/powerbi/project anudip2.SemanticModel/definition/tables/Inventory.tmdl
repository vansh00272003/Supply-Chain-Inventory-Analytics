table Inventory
	lineageTag: 4165151d-6b21-416c-940e-1a337dda8a3c

	measure 'Inventory Value' = SUMX(Inventory, Inventory[Stock_On_Hand] * LOOKUPVALUE(Products[Unit_Cost], Products[Product_ID], Inventory[Product_ID]))
		lineageTag: 95eeb3ee-26e4-49b6-bf3c-43d9e72fca00

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Stockout Count' = CALCULATE(COUNTROWS(Inventory), Inventory[Stock_On_Hand] = 0)
		formatString: 0
		lineageTag: 3fc5645b-7849-41c5-b242-37e46ccebe07

	measure 'Low Stock Count' = CALCULATE(COUNTROWS(Inventory), FILTER(Inventory, Inventory[Stock_On_Hand] < LOOKUPVALUE(Products[Reorder_Level], Products[Product_ID], Inventory[Product_ID])))
		formatString: 0
		lineageTag: 705e2ca2-7174-44b5-98ae-a518fdc5318d

	measure 'Critical Stock Count' = CALCULATE(COUNTROWS(Inventory), FILTER(Inventory, Inventory[Stock_On_Hand] < LOOKUPVALUE(Products[Safety_Stock], Products[Product_ID], Inventory[Product_ID])))
		formatString: 0
		lineageTag: 01e4c622-2598-45e3-831c-7ae895edee83

	measure 'Overstock Count' = CALCULATE(COUNTROWS(Inventory), FILTER(Inventory, Inventory[Stock_On_Hand] > (3 * LOOKUPVALUE(Products[Reorder_Level], Products[Product_ID], Inventory[Product_ID]))))
		formatString: 0
		lineageTag: 8bd31250-0721-49b7-857a-f41894f58406

