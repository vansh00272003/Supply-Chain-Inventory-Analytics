table Sales_Orders
	lineageTag: 890f03b8-8a4c-4593-b376-17e83ba2ee24

	measure 'Total Sales' = SUM(Sales_Orders[Sales_Amount])
		lineageTag: 43cf5519-bd9b-4d1a-9668-1fb131f43934

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total COGS' = SUM(Sales_Orders[COGS])
		lineageTag: 6260555f-fac9-45e3-b253-a8c3f4414938

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gross Profit' = [Total Sales] - [Total COGS]
		lineageTag: 7467b3be-e271-4651-8b33-9b6300f7947f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Profit Margin %' = DIVIDE([Gross Profit], [Total Sales], 0)
		lineageTag: 8ada6b4a-54bb-4394-940d-ec8e5efe8974

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Orders' = DISTINCTCOUNT(Sales_Orders[Order_ID])
		formatString: 0
		lineageTag: d4d29eed-2638-4206-9273-f1df80ac44b7

	measure 'Units Sold' = SUM(Sales_Orders[Quantity])
		formatString: 0
		lineageTag: 1cf42f8e-fea2-4862-9f44-bb61d7425491

	measure 'Average Order Value' = DIVIDE([Total Sales], [Total Orders], 0)
		lineageTag: 4dcb4b6b-3b96-4253-b897-3e5fed52a969

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Discount %' = AVERAGE(Sales_Orders[Discount_Pct])
		lineageTag: 18b46153-8d87-4c3f-bc29-45746f9eb6e7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

